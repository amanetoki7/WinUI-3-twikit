<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="WinUI3Twikit.Controls.QuotedTweetCard"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinUI3Twikit"
    xmlns:controls="using:WinUI3Twikit.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
        <local:InverseBoolConverter x:Key="InverseBoolConverter" />
        <local:MediaTypeToVisibilityConverter x:Key="MediaTypeToVisibilityConverter" />
    </UserControl.Resources>

    <Border x:Name="QuoteBorder"
            BorderBrush="#2A2A2A"
            BorderThickness="1"
            CornerRadius="12"
            Padding="12"
            Background="#1A1A1A"
            IsHitTestVisible="{x:Bind Tweet.QuotedTweet.IsUnavailable, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}"
            PointerEntered="QuoteBorder_PointerEntered"
            PointerExited="QuoteBorder_PointerExited"
            Tapped="QuoteBorder_Tapped">
        <StackPanel Spacing="12">
            <controls:TweetUserRow
                Visibility="{x:Bind Tweet.QuotedTweet.IsUnavailable, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                UserName="{x:Bind Tweet.QuotedTweet.UserName, Mode=OneWay}"
                UserScreenName="{x:Bind Tweet.QuotedTweet.UserScreenName, Mode=OneWay}"
                IsUserProtected="{x:Bind Tweet.QuotedTweet.IsUserProtected, Mode=OneWay}"
                IsUserVerified="{x:Bind Tweet.QuotedTweet.IsUserVerified, Mode=OneWay}"
                CreatedAtAbsoluteDisplay="{x:Bind Tweet.QuotedTweet.CreatedAtAbsoluteDisplay, Mode=OneWay}"
                CreatedAtRelativeDisplay="{x:Bind Tweet.QuotedTweet.CreatedAtRelativeDisplay, Mode=OneWay}"
                UserProfileImage="{x:Bind Tweet.QuotedTweet.UserProfileImage, Mode=OneWay}"/>

            <TextBlock Text="{x:Bind Tweet.QuotedTweet.Text, Mode=OneWay}"
                       FontSize="15"
                       LineHeight="20"
                       TextWrapping="WrapWholeWords"
                       IsTextSelectionEnabled="True"
                       Visibility="{x:Bind Tweet.QuotedTweet.IsUnavailable, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>

            <ItemsControl ItemsSource="{x:Bind Tweet.QuotedCardMediaItems, Mode=OneWay}"
                          Visibility="{x:Bind Tweet.QuotedCardHasMedia, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="8"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:MediaItem">
                        <Border CornerRadius="8" Background="#1A1A1A" Margin="0,4" MaxWidth="320">
                            <Grid>
                                <Image Source="{x:Bind ThumbnailImage, Mode=OneTime}"
                                       Tag="{x:Bind Url, Mode=OneTime}"
                                       Stretch="Uniform"
                                       MaxHeight="260"
                                       HorizontalAlignment="Center"
                                       Tapped="MediaThumbnail_Tapped"/>
                                <Border Background="#80000000"
                                        CornerRadius="32"
                                        Width="64" Height="64"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        IsHitTestVisible="False"
                                        Visibility="{x:Bind Type, Converter={StaticResource MediaTypeToVisibilityConverter}, ConverterParameter=video}">
                                    <FontIcon Glyph="&#xE768;" FontSize="28" Foreground="White"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="このツイートは表示できません"
                       FontStyle="Italic"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       HorizontalAlignment="Center"
                       Visibility="{x:Bind Tweet.QuotedTweet.IsUnavailable, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
        </StackPanel>
    </Border>
</UserControl>