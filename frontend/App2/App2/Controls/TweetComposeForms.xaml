<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="WinUI3Twikit.Controls.TweetComposeForms"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinUI3Twikit"
    xmlns:controls="using:WinUI3Twikit.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    x:DefaultBindMode="OneWay">

    <UserControl.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </UserControl.Resources>

    <StackPanel>
        <Border x:Name="ReplyForm"
                x:Load="{x:Bind Tweet.IsReplying, Mode=OneWay, FallbackValue=False}"
                Tag="{x:Bind Tweet}"
                PreviewKeyDown="ReplyForm_PreviewKeyDown"
                Margin="0,8,0,20" Padding="16" CornerRadius="12"
                Background="#1F1F1F" BorderBrush="#2A2A2A" BorderThickness="1">
            <StackPanel Spacing="12">
                <TextBlock Text="このツイートに返信" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                <Border Background="#252525" CornerRadius="8" Padding="12">
                    <TextBox Text="{x:Bind Tweet.ReplyText, Mode=OneWay}"
                             PlaceholderText="返信を入力..."
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MinHeight="110"
                             BorderThickness="0"
                             Background="Transparent"/>
                </Border>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
                    <Button Content="キャンセル" Click="CancelReply_Click" Style="{StaticResource SubtleButtonStyle}"
                            IsEnabled="{x:Bind Tweet.IsReplySendEnabled}"/>
                    <Button Content="リプライを送信" Click="SendReply_Click" Style="{StaticResource AccentButtonStyle}"
                            IsEnabled="{x:Bind Tweet.IsReplySendEnabled}"/>
                    <ProgressRing Width="24" Height="24"
                                  IsActive="{x:Bind Tweet.IsReplySending}"
                                  Visibility="{x:Bind Tweet.IsReplySending, Converter={StaticResource BoolToVisibilityConverter}}"
                                  VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border x:Name="QuoteForm"
                x:Load="{x:Bind Tweet.IsQuoting, Mode=OneWay, FallbackValue=False}"
                Tag="{x:Bind Tweet}"
                PreviewKeyDown="QuoteForm_PreviewKeyDown"
                Margin="0,8,0,20" Padding="16" CornerRadius="12"
                Background="#1F1F1F" BorderBrush="#2A2A2A" BorderThickness="1">
            <StackPanel Spacing="12">
                <TextBlock Text="引用ツイート" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                <Border Background="#252525" CornerRadius="8" Padding="12">
                    <TextBox x:Name="QuoteTextBox"
                             Text="{x:Bind Tweet.QuoteText, Mode=OneWay}"
                             PlaceholderText="コメントを追加...（画像は Ctrl+V で添付）"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MinHeight="110"
                             BorderThickness="0"
                             Background="Transparent"/>
                </Border>
                <controls:QuoteMediaBar DataContext="{x:Bind Tweet}"/>
                <controls:QuotedTweetCard Tweet="{x:Bind Tweet.QuotePreviewTweet}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
                    <Button Content="キャンセル" Click="CancelQuote_Click" Style="{StaticResource SubtleButtonStyle}"
                            IsEnabled="{x:Bind Tweet.IsQuoteSendEnabled}"/>
                    <Button Content="引用ツイートを送信" Click="SendQuote_Click" Style="{StaticResource AccentButtonStyle}"
                            IsEnabled="{x:Bind Tweet.IsQuoteSendEnabled}"/>
                    <ProgressRing Width="24" Height="24"
                                  IsActive="{x:Bind Tweet.IsQuoteSending}"
                                  Visibility="{x:Bind Tweet.IsQuoteSending, Converter={StaticResource BoolToVisibilityConverter}}"
                                  VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
