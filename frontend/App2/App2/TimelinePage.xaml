<Page
    x:Class="WinUI3Twikit.TimelinePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinUI3Twikit"
    xmlns:controls="using:WinUI3Twikit.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
    </Page.Resources>

    <Grid Padding="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 自動更新コントロール -->
            <RowDefinition Height="Auto"/>
            <!-- タブ -->
            <RowDefinition Height="*"/>
            <!-- タイムライン -->
        </Grid.RowDefinitions>

        <!-- 1. 自動更新コントロール -->
        <StackPanel Orientation="Horizontal"
            Spacing="16"
            VerticalAlignment="Center"
            Margin="12,8,12,1"
            Grid.Row="0">

            <!-- 自動更新ヘッダー -->
            <TextBlock Text="自動更新"
               VerticalAlignment="Center"
               FontSize="14"/>

            <!-- ON/OFF ボタン -->
            <ToggleSwitch x:Name="AutoUpdateToggle"
                  OnContent="ON"
                  OffContent="OFF"
                  Toggled="AutoUpdateToggle_Toggled"
                  IsOn="False"
                  VerticalAlignment="Center"/>

            <!-- 間隔(秒) + NumberBox -->
            <StackPanel Orientation="Horizontal"
                Spacing="8"
                VerticalAlignment="Center">

                <TextBlock Text="間隔(秒)"
                   VerticalAlignment="Center"
                   FontSize="14"/>

                <NumberBox x:Name="PollingIntervalBox"
                   Value="15"
                   Minimum="5"
                   Maximum="300"
                   Width="80"
                   SpinButtonPlacementMode="Hidden"
                   SmallChange="5"/>

                <Button x:Name="ForceRefreshButton"
                        Content="新着取得"
                        Click="ForceRefreshButton_Click"
                        VerticalAlignment="Center"
                        Style="{StaticResource AccentButtonStyle}"
                        Padding="12,4"
                        ToolTipService.ToolTip="自動更新がオフのときなど、手動で新しいツイートを読み込みます"/>
            </StackPanel>
        </StackPanel>

        <!-- 2. タブ（おすすめ / 最新） -->
        <TabView x:Name="TimelineTabView" 
                 TabWidthMode="SizeToContent" 
                 SelectedIndex="0" 
                 SelectionChanged="TimelineTabView_SelectionChanged"
                 Margin="12,1,12,4"
                 Grid.Row="1">
            <TabView.TabItems>
                <TabViewItem Header="おすすめ" Tag="for_you" />
                <TabViewItem Header="最新" Tag="latest" />
            </TabView.TabItems>
        </TabView>

        <!-- 3. 読み込み中 -->
        <ProgressRing
            Width="60" Height="60"
            IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Grid.Row="2"
            IsIndeterminate="True"/>

        <!-- 4. タイムライン -->
        <ListView ItemsSource="{x:Bind ViewModel.Tweets, Mode=OneWay}"
                  SelectionMode="None"
                  Padding="8"
                  x:Name="TimelineListView"
                  controls:TweetCard.HostActions="{x:Bind ViewModel}"
                  Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                  Grid.Row="2"
                  Margin="0,0,0,0">

            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsStackPanel />
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>

            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:TweetViewModel">
                    <controls:TweetCard Tweet="{x:Bind}"/>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
