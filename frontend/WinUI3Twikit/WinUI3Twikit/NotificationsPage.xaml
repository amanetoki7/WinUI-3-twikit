<Page
    x:Class="WinUI3Twikit.NotificationsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinUI3Twikit"
    xmlns:controls="using:WinUI3Twikit.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
        <local:MediaTypeToVisibilityConverter x:Key="MediaTypeToVisibilityConverter" />
    </Page.Resources>

    <Grid Padding="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TabView x:Name="NotificationsTabView"
                 TabWidthMode="SizeToContent"
                 SelectedIndex="0"
                 SelectionChanged="NotificationsTabView_SelectionChanged"
                 IsAddTabButtonVisible="False"
                 CanDragTabs="False"
                 CanReorderTabs="False"
                 Margin="12,1,12,4"
                 Grid.Row="0">
            <TabView.TabItems>
                <TabViewItem Header="すべて" Tag="all" />
                <TabViewItem Header="@ツイート" Tag="mentions" />
            </TabView.TabItems>
        </TabView>

        <!-- 読み込み中 -->
        <ProgressRing
            Width="60" Height="60"
            IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Grid.Row="1"
            IsIndeterminate="True"/>

        <!-- 通知リスト -->
        <ListView ItemsSource="{x:Bind ViewModel.Notifications, Mode=OneWay}"
                  SelectionMode="None"
                  Padding="8"
                  controls:TweetCard.HostActions="{x:Bind ViewModel}"
                  x:Name="NotificationsListView"
                  Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                  Grid.Row="1">

            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsStackPanel />
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>

            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:NotificationViewModel">
                    <StackPanel>
                    <Border Margin="0,6" Padding="16" CornerRadius="12"
                            Background="{ThemeResource TweetCardBackgroundBrush}" BorderBrush="{ThemeResource TweetCardBorderBrush}" BorderThickness="1">

                        <StackPanel Spacing="12">
                            <controls:TweetUserRow
                                x:Name="ReplyUserRow"
                                x:Load="{x:Bind IsTweetCard, Mode=OneWay, FallbackValue=False}"
                                UserName="{x:Bind ActorName, Mode=OneWay}"
                                UserScreenName="{x:Bind ActorScreenNameDisplay, Mode=OneWay}"
                                IsUserProtected="{x:Bind IsActorProtected, Mode=OneWay}"
                                IsUserVerified="{x:Bind IsActorVerified, Mode=OneWay}"
                                CreatedAtAbsoluteDisplay="{x:Bind CreatedAtAbsoluteDisplay, Mode=OneWay}"
                                CreatedAtRelativeDisplay="{x:Bind CreatedAtRelativeDisplay, Mode=OneWay}"
                                UserProfileImage="{x:Bind ActorProfileImage, Mode=OneWay}"
                                ReplyToScreenName="{x:Bind ReplyToScreenName, Mode=OneWay}"/>

                            <StackPanel x:Name="AggregateHeader"
                                        x:Load="{x:Bind ShowAggregateHeader, Mode=OneWay, FallbackValue=True}"
                                        Orientation="Horizontal" Spacing="12">
                                <PersonPicture Width="48" Height="48" ProfilePicture="{x:Bind ActorProfileImage, Mode=OneWay}"/>

                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{x:Bind ActorName}"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                                   FontSize="15"/>
                                        <TextBlock Text="{x:Bind ActorScreenName}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="1"
                                               Text="{x:Bind CreatedAtDisplay, Mode=OneWay}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               VerticalAlignment="Center"
                                               Margin="12,0,0,0"/>
                                </Grid>
                            </StackPanel>

                            <!-- 通知本文。いいね・リポスト・フォローだけ先頭にマークを付ける。 -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <FontIcon Grid.Column="0"
                                          Glyph="{x:Bind IconGlyph, Mode=OneWay}"
                                          Foreground="{x:Bind IconForeground, Mode=OneWay}"
                                          FontSize="18"
                                          Width="18"
                                          Margin="0,1,8,0"
                                          VerticalAlignment="Top"
                                          Visibility="{x:Bind HasTypeIcon, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                          AutomationProperties.AccessibilityView="Raw"/>
                                <TextBlock Grid.Column="1"
                                           Text="{x:Bind Text}"
                                           TextWrapping="WrapWholeWords"
                                           FontSize="15"
                                           LineHeight="20"
                                           IsTextSelectionEnabled="True"/>
                            </Grid>

                            <!-- リプライ・メンション自身のメディア -->
                            <ItemsControl
                                x:Name="ReplyMediaItems"
                                x:Load="{x:Bind IsTweetCard, Mode=OneWay, FallbackValue=False}"
                                ItemsSource="{x:Bind ActionTweet.MediaItems, Mode=OneWay}"
                                Visibility="{x:Bind ActionTweet.HasOuterMedia, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="8"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="local:MediaItem">
                                        <Border CornerRadius="8"
                                                Background="{ThemeResource TweetMediaBackgroundBrush}"
                                                Margin="0,4"
                                                MaxWidth="320">
                                            <Grid>
                                                <Image Source="{x:Bind ThumbnailImage, Mode=OneTime}"
                                                       Tag="{x:Bind Url, Mode=OneTime}"
                                                       Stretch="Uniform"
                                                       MaxHeight="260"
                                                       HorizontalAlignment="Center"
                                                       Tapped="MediaThumbnail_Tapped"/>
                                                <Border Background="#80000000"
                                                        CornerRadius="32"
                                                        Width="64"
                                                        Height="64"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        IsHitTestVisible="False"
                                                        Visibility="{x:Bind Type, Mode=OneTime, Converter={StaticResource MediaTypeToVisibilityConverter}, ConverterParameter=video}">
                                                    <FontIcon Glyph="&#xE768;"
                                                              FontSize="28"
                                                              Foreground="White"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- 対象ツイート。リプライは target が空なので出さない。 -->
                            <Border Visibility="{x:Bind HasTargetTweet, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                    Background="{ThemeResource TweetCardInsetBackgroundBrush}" CornerRadius="8" Padding="12">
                                <TextBlock Text="{x:Bind TargetTweetText}"
                                           TextWrapping="Wrap"
                                           FontSize="14"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           IsTextSelectionEnabled="True"/>
                            </Border>

                            <controls:QuotedTweetCard
                                x:Name="QuotedTweetPresenter"
                                x:Load="{x:Bind ActionTweet.HasQuotedTweet, Mode=OneWay, FallbackValue=False}"
                                Tweet="{x:Bind ActionTweet, Mode=OneWay}"/>

                            <controls:TweetActionBar
                                x:Name="ReplyActions"
                                x:Load="{x:Bind IsTweetCard, Mode=OneWay, FallbackValue=False}"
                                Tweet="{x:Bind ActionTweet, Mode=OneWay}"/>
                        </StackPanel>
                    </Border>

                    <controls:TweetComposeForms
                        x:Name="ReplyCompose"
                        x:Load="{x:Bind IsTweetCard, Mode=OneWay, FallbackValue=False}"
                        Tweet="{x:Bind ActionTweet, Mode=OneWay}"/>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
