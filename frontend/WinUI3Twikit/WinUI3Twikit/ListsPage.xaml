<Page
    x:Class="WinUI3Twikit.ListsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinUI3Twikit"
    xmlns:controls="using:WinUI3Twikit.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
    </Page.Resources>

    <Grid Padding="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- パンくず（ツイートページのタイトルと同じ FontSize=24） -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="8,0,4,12" VerticalAlignment="Center">
            <TextBlock Text="リスト"
                       FontSize="24"
                       VerticalAlignment="Center"
                       Visibility="{x:Bind ViewModel.ShowListCatalog, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>

            <Button Content="リスト"
                    Click="BreadcrumbList_Click"
                    Style="{StaticResource SubtleButtonStyle}"
                    FontSize="24"
                    Padding="0"
                    MinHeight="0"
                    MinWidth="0"
                    BorderThickness="0"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    Visibility="{x:Bind ViewModel.ShowTimeline, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>

            <TextBlock Text=">"
                       FontSize="24"
                       VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Visibility="{x:Bind ViewModel.ShowTimeline, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>

            <TextBlock Text="{x:Bind ViewModel.SelectedListName, Mode=OneWay}"
                       FontSize="24"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       Visibility="{x:Bind ViewModel.ShowTimeline, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
        </StackPanel>

        <!-- 読み込み中 -->
        <ProgressRing Grid.Row="1"
                      Width="60" Height="60"
                      IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                      Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"/>

        <!-- リストなし -->
        <TextBlock Grid.Row="1"
                   Text="リストはありません"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   FontSize="15"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Visibility="{x:Bind ViewModel.IsListCatalogEmptyVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>

        <!-- リスト一覧 -->
        <ListView Grid.Row="1"
                  x:Name="ListsListView"
                  ItemsSource="{x:Bind ViewModel.Lists, Mode=OneWay}"
                  SelectionMode="None"
                  IsItemClickEnabled="True"
                  ItemClick="ListsListView_ItemClick"
                  Visibility="{x:Bind ViewModel.IsListCatalogContentVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">

            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:ListItemViewModel">
                    <Border Margin="0,6" Padding="16" CornerRadius="12"
                            Background="{ThemeResource TweetCardBackgroundBrush}" BorderBrush="{ThemeResource TweetCardBorderBrush}" BorderThickness="1">
                        <StackPanel Spacing="6">
                            <TextBlock Text="{x:Bind Name}"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                       FontSize="16"/>
                            <TextBlock Text="{x:Bind Description}"
                                       TextWrapping="WrapWholeWords"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       MaxLines="2"
                                       TextTrimming="CharacterEllipsis"/>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock Text="{x:Bind MemberInfo}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Text="{x:Bind Mode}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- リストタイムライン -->
        <ListView Grid.Row="1"
                  x:Name="TimelineListView"
                  ItemsSource="{x:Bind ViewModel.Tweets, Mode=OneWay}"
                  SelectionMode="None"
                  Padding="8"
                  controls:TweetCard.HostActions="{x:Bind ViewModel}"
                  Visibility="{x:Bind ViewModel.IsTimelineContentVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">

            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsStackPanel/>
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>

            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:TweetViewModel">
                    <controls:TweetCard Tweet="{x:Bind}"/>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
