<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="WinUI3Twikit.Controls.TweetCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinUI3Twikit"
    xmlns:controls="using:WinUI3Twikit.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    x:DefaultBindMode="OneWay">

    <UserControl.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </UserControl.Resources>

    <StackPanel>
        <!-- ホバー色と、会話ページで開いているツイートの枠。テーマごとの値は App.xaml の ThemeDictionaries を参照 -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="PointerStates">
                <VisualState x:Name="Normal"/>
                <VisualState x:Name="PointerOver">
                    <VisualState.Setters>
                        <Setter Target="CardBorder.Background" Value="{ThemeResource TweetCardHoverBackgroundBrush}"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup x:Name="FocalStates">
                <VisualState x:Name="NotFocal"/>
                <VisualState x:Name="Focal">
                    <VisualState.Setters>
                        <Setter Target="CardBorder.BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <!-- クリックで会話ページへ（ボタン・リンク・メディア・アイコン・引用はそれぞれの動作を優先） -->
        <Border x:Name="CardBorder"
                Margin="0,6" Padding="16" CornerRadius="12"
                Background="{ThemeResource TweetCardBackgroundBrush}" BorderBrush="{ThemeResource TweetCardBorderBrush}" BorderThickness="1"
                PointerEntered="CardBorder_PointerEntered"
                PointerExited="CardBorder_PointerExited"
                PointerCanceled="CardBorder_PointerExited"
                PointerCaptureLost="CardBorder_PointerExited">
            <StackPanel Spacing="12">
                <!-- プロフィールに固定されたツイート（ユーザーのツイート一覧の 1 ページ目） -->
                <StackPanel Orientation="Horizontal" Spacing="6"
                            Visibility="{x:Bind Tweet.IsPinned, Converter={StaticResource BoolToVisibilityConverter}}">
                    <FontIcon Glyph="&#xE718;" FontSize="13"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="固定されたツイート"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Style="{StaticResource CaptionTextBlockStyle}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="6"
                            Visibility="{x:Bind Tweet.IsRetweet, Converter={StaticResource BoolToVisibilityConverter}}">
                    <FontIcon Glyph="&#xE72A;" FontSize="14"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="{x:Bind Tweet.RetweetHeaderText}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Style="{StaticResource CaptionTextBlockStyle}"/>
                </StackPanel>

                <controls:TweetUserRow
                    UserName="{x:Bind Tweet.UserName}"
                    UserScreenName="{x:Bind Tweet.UserScreenName}"
                    IsUserProtected="{x:Bind Tweet.IsUserProtected}"
                    IsUserVerified="{x:Bind Tweet.IsUserVerified}"
                    CreatedAtAbsoluteDisplay="{x:Bind Tweet.CreatedAtAbsoluteDisplay}"
                    CreatedAtRelativeDisplay="{x:Bind Tweet.CreatedAtRelativeDisplay}"
                    UserProfileImage="{x:Bind Tweet.UserProfileImage}"
                    ReplyToScreenName="{x:Bind ReplyToFor(Tweet.ReplyToScreenName, ShowReplyTo)}"/>

                <!-- URL / ハッシュタグ / メンションをリンク化。URL はブラウザ、# は検索、@ はプロフィール検索へ -->
                <controls:TweetTextBlock Text="{x:Bind Tweet.Text}"
                                         Urls="{x:Bind Tweet.Urls}"
                                         Visibility="{x:Bind Tweet.HasText, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <!-- サムネイルを横に並べ、画像は切り抜かず全体を表示。クリックで拡大プレビュー -->
                <controls:MediaStrip Items="{x:Bind Tweet.MediaItems}"/>

                <controls:QuotedTweetCard
                    x:Name="QuotedTweetPresenter"
                    x:Load="{x:Bind Tweet.HasQuotedTweet, Mode=OneWay, FallbackValue=False}"
                    Tweet="{x:Bind Tweet}"/>

                <controls:TweetActionBar Tweet="{x:Bind Tweet, Mode=OneWay}"/>
            </StackPanel>
        </Border>

        <controls:TweetComposeForms Tweet="{x:Bind Tweet, Mode=OneWay}"/>
    </StackPanel>
</UserControl>
