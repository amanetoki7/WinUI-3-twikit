<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="WinUI3Twikit.Controls.TweetCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinUI3Twikit"
    xmlns:controls="using:WinUI3Twikit.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    x:DefaultBindMode="OneWay">

    <UserControl.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <local:MediaTypeToVisibilityConverter x:Key="MediaTypeToVisibilityConverter" />
    </UserControl.Resources>

    <StackPanel>
        <Border Margin="0,6" Padding="16" CornerRadius="12"
                Background="#1F1F1F" BorderBrush="#2A2A2A" BorderThickness="1">
            <StackPanel Spacing="12">
                <StackPanel Orientation="Horizontal" Spacing="6"
                            Visibility="{x:Bind Tweet.IsRetweet, Converter={StaticResource BoolToVisibilityConverter}}">
                    <FontIcon Glyph="&#xE72A;" FontSize="14"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="{x:Bind Tweet.RetweetHeaderText}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Style="{StaticResource CaptionTextBlockStyle}"/>
                </StackPanel>

                <controls:TweetUserRow
                    UserName="{x:Bind Tweet.UserName}"
                    UserScreenName="{x:Bind Tweet.UserScreenName}"
                    IsUserProtected="{x:Bind Tweet.IsUserProtected}"
                    IsUserVerified="{x:Bind Tweet.IsUserVerified}"
                    CreatedAtAbsoluteDisplay="{x:Bind Tweet.CreatedAtAbsoluteDisplay}"
                    CreatedAtRelativeDisplay="{x:Bind Tweet.CreatedAtRelativeDisplay}"
                    UserProfileImage="{x:Bind Tweet.UserProfileImage}"/>

                <TextBlock Text="{x:Bind Tweet.Text}"
                           TextWrapping="WrapWholeWords"
                           FontSize="15"
                           LineHeight="20"
                           IsTextSelectionEnabled="True"
                           Visibility="{x:Bind Tweet.HasText, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <ItemsControl ItemsSource="{x:Bind Tweet.MediaItems}"
                              Visibility="{x:Bind Tweet.HasOuterMedia, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="8"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:MediaItem">
                            <Border CornerRadius="8" Background="#1A1A1A" Margin="0,4" MaxWidth="320">
                                <Grid>
                                    <Image Source="{x:Bind ThumbnailImage, Mode=OneTime}"
                                           Tag="{x:Bind Url, Mode=OneTime}"
                                           Stretch="Uniform"
                                           MaxHeight="260"
                                           HorizontalAlignment="Center"
                                           Tapped="MediaThumbnail_Tapped"/>
                                    <Border Background="#80000000"
                                            CornerRadius="32"
                                            Width="64" Height="64"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            IsHitTestVisible="False"
                                            Visibility="{x:Bind Type, Mode=OneTime, Converter={StaticResource MediaTypeToVisibilityConverter}, ConverterParameter=video}">
                                        <FontIcon Glyph="&#xE768;" FontSize="28" Foreground="White"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <controls:QuotedTweetCard
                    x:Name="QuotedTweetPresenter"
                    x:Load="{x:Bind Tweet.HasQuotedTweet, Mode=OneWay, FallbackValue=False}"
                    Tweet="{x:Bind Tweet}"/>

                <controls:TweetActionBar Tweet="{x:Bind Tweet, Mode=OneWay}"/>
            </StackPanel>
        </Border>

        <controls:TweetComposeForms Tweet="{x:Bind Tweet, Mode=OneWay}"/>
    </StackPanel>
</UserControl>
