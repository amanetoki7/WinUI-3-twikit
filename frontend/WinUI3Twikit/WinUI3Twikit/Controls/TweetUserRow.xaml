<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="WinUI3Twikit.Controls.TweetUserRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinUI3Twikit"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </UserControl.Resources>

    <Grid ColumnSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <PersonPicture Grid.Column="0"
                       Width="48"
                       Height="48"
                       VerticalAlignment="Center"
                       ProfilePicture="{x:Bind UserProfileImage, Mode=OneWay}"
                       Tapped="ProfileImage_Tapped"
                       ToolTipService.ToolTip="プロフィールを表示"/>

        <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <StackPanel Orientation="Horizontal"
                            Spacing="4"
                            VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind UserName, Mode=OneWay}"
                               FontSize="15"
                               LineHeight="20"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <FontIcon Glyph="&#xE73E;"
                              FontSize="12"
                              VerticalAlignment="Center"
                              Foreground="#1D9BF0"
                              Visibility="{x:Bind IsUserVerified, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <FontIcon Glyph="&#xE72E;"
                              FontSize="12"
                              VerticalAlignment="Center"
                              Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                              Visibility="{x:Bind IsUserProtected, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </StackPanel>
                <TextBlock Text="{x:Bind UserScreenName, Mode=OneWay}"
                           FontSize="15"
                           LineHeight="20"
                           FontWeight="Light"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center"/>
                <TextBlock Text="{x:Bind CreatedAtAbsoluteDisplay, Mode=OneWay}"
                           FontSize="15"
                           LineHeight="20"
                           FontWeight="Light"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center"/>
                <TextBlock Text="・"
                           FontSize="15"
                           LineHeight="20"
                           FontWeight="Light"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center"/>
                <TextBlock Text="{x:Bind CreatedAtRelativeDisplay, Mode=OneWay}"
                           FontSize="15"
                           LineHeight="20"
                           FontWeight="Light"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal"
                        Margin="0,2,0,0"
                        Visibility="{x:Bind HasReplyTo, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="返信先: "
                           FontSize="15"
                           LineHeight="20"
                           FontWeight="Light"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock Text="{x:Bind ReplyToDisplay, Mode=OneWay}"
                           FontSize="15"
                           LineHeight="20"
                           FontWeight="Light"
                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
