<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="WinUI3Twikit.Controls.QuotedTweetCard"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinUI3Twikit"
    xmlns:controls="using:WinUI3Twikit.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
        <local:InverseBoolConverter x:Key="InverseBoolConverter" />
    </UserControl.Resources>

    <!-- クリックで引用元を既定のブラウザで開く -->
    <Border x:Name="QuoteBorder"
            BorderBrush="{ThemeResource QuotedTweetCardBorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="12"
            Background="{ThemeResource QuotedTweetCardBackgroundBrush}"
            IsHitTestVisible="{x:Bind Tweet.QuotedTweet.IsUnavailable, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}"
            PointerEntered="QuoteBorder_PointerEntered"
            PointerExited="QuoteBorder_PointerExited"
            Tapped="QuoteBorder_Tapped"
            ToolTipService.ToolTip="引用元をブラウザで開く">
        <!-- ホバー色。テーマごとの値は App.xaml の ThemeDictionaries を参照 -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="PointerStates">
                <VisualState x:Name="Normal"/>
                <VisualState x:Name="PointerOver">
                    <VisualState.Setters>
                        <Setter Target="QuoteBorder.Background" Value="{ThemeResource QuotedTweetCardHoverBackgroundBrush}"/>
                        <Setter Target="QuoteBorder.BorderBrush" Value="{ThemeResource QuotedTweetCardHoverBorderBrush}"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <StackPanel Spacing="12">
            <controls:TweetUserRow
                Visibility="{x:Bind Tweet.QuotedTweet.IsUnavailable, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                UserName="{x:Bind Tweet.QuotedTweet.UserName, Mode=OneWay}"
                UserScreenName="{x:Bind Tweet.QuotedTweet.UserScreenName, Mode=OneWay}"
                IsUserProtected="{x:Bind Tweet.QuotedTweet.IsUserProtected, Mode=OneWay}"
                IsUserVerified="{x:Bind Tweet.QuotedTweet.IsUserVerified, Mode=OneWay}"
                CreatedAtAbsoluteDisplay="{x:Bind Tweet.QuotedTweet.CreatedAtAbsoluteDisplay, Mode=OneWay}"
                CreatedAtRelativeDisplay="{x:Bind Tweet.QuotedTweet.CreatedAtRelativeDisplay, Mode=OneWay}"
                UserProfileImage="{x:Bind Tweet.QuotedTweet.UserProfileImage, Mode=OneWay}"/>

            <controls:TweetTextBlock Text="{x:Bind Tweet.QuotedTweet.Text, Mode=OneWay}"
                                     Urls="{x:Bind Tweet.QuotedTweet.Urls, Mode=OneWay}"
                                     Visibility="{x:Bind Tweet.QuotedTweet.IsUnavailable, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>

            <controls:MediaStrip Items="{x:Bind Tweet.QuotedCardMediaItems, Mode=OneWay}"/>

            <TextBlock Text="このツイートは表示できません"
                       FontStyle="Italic"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       HorizontalAlignment="Center"
                       Visibility="{x:Bind Tweet.QuotedTweet.IsUnavailable, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
        </StackPanel>
    </Border>
</UserControl>
